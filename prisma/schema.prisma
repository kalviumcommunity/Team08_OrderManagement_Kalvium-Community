model InventoryLog {
  id               String   @id @default(uuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  ownerId          String?
  owner            User?    @relation(fields: [ownerId], references: [id])
  previousQuantity Int
  newQuantity      Int
  changeAmount     Int
  reason           String
  timestamp        DateTime @default(now())
}
